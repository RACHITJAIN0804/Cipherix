APP_NAME=Cipherix
APP_ENV=development
DEBUG=True

SECRET_KEY=change_this_in_production
LOG_LEVEL=INFO

# CORS — JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# JWT — generate a strong random secret for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_jwt_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Vector & Embedding Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_DB_DIR_NAME=cipherix_vectors
EMBEDDING_BATCH_SIZE=32
SEARCH_DEFAULT_TOP_K=5

# ---------------------------------------------------------------------------
# Local LLM Settings (Ollama)
# ---------------------------------------------------------------------------
# Requires Ollama: https://ollama.com/download
# Start Ollama:  ollama serve
# Pull a model:  ollama pull llama3.2:1b   (recommended — ~750 MB, CPU-friendly)
# Alternative:   ollama pull phi3.5        (~2.2 GB, stronger reasoning)
#
# Set to "disabled" to turn off LLM generation (RAG returns a canned answer).
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=llama3.2:1b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# RAG Pipeline Settings
# ---------------------------------------------------------------------------
RAG_MAX_CHUNKS=5
RAG_MAX_CONTEXT_CHARS=4000
RAG_MIN_SIMILARITY=0.30
