APP_NAME=Cipherix
APP_ENV=development
DEBUG=True

SECRET_KEY=change_this_in_production
LOG_LEVEL=INFO

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_jwt_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Blockchain — Local Ganache Development ────────────────────────────────────
# See backend/blockchain/README.md for full setup instructions.
#
# 1. Install Ganache:  npm install -g ganache
# 2. Start Ganache:    npx ganache --deterministic
# 3. Copy account [0] address and private key from Ganache output below.
# 4. Run connection test: python blockchain/connection_test.py

BLOCKCHAIN_ENABLED=True
BLOCKCHAIN_PROVIDER=ganache
BLOCKCHAIN_NETWORK=local-development

# Ganache JSON-RPC endpoint (default port: 8545)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# EVM chain ID — Ganache default is 1337
BLOCKCHAIN_CHAIN_ID=1337

# Paste from "Available Accounts [0]" in Ganache output
BLOCKCHAIN_DEPLOYER_ADDRESS=

# Paste from "Private Keys [0]" in Ganache output
# ONLY use Ganache test keys — NEVER a real private key here
BLOCKCHAIN_PRIVATE_KEY=

# Set after deploying DocumentIntegrity.sol (Step 2)
BLOCKCHAIN_CONTRACT_ADDRESS=
